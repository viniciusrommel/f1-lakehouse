# ── Postgres OLTP (fonte CDC — Debezium lê o WAL deste banco) ──────────────────
PG_HOST=postgres
PG_PORT=5432
PG_USER=f1user
PG_PASSWORD=f1pass
PG_DATABASE=f1oltp

# ── FastF1 ─────────────────────────────────────────────────────────────────────
FASTF1_CACHE_DIR=/tmp/fastf1_cache
F1_SEASON=2024

# ── AWS S3 (S3 Sink Connector — landing zone real do CDC) ──────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
# bucket já fixado nos artefatos (s3-sink-connector.aws.json, notebooks Databricks)
# s3://f1-lakehouse-galgo

# ── Databricks (dbt-databricks, lido via env_var() em dbt/f1_lakehouse/profiles.yml) ──
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=f1

# ── Observability ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
